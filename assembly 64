; =========================================================
; PROCEDURE: DOT PRODUCT
; Bryce Okumara - Procedure / Functions
; =========================================================

dot_product:

mov rcx, 3
xor rax, rax

dp_loop:

mov rbx, [rsi]
imul rbx, [rdi]

add rax, rbx

add rsi, 8
add rdi, 8

dec rcx
jnz dp_loop

ret


; =========================================================
; PROCEDURE: PARSE VECTOR
; Converts ASCII input into integers
; =========================================================

parse_vector:

mov rcx, 3

next_num:

xor rax, rax
xor rbx, rbx
xor rdx, rdx

mov bl, [rsi]
cmp bl, '-'
jne convert_digits

mov dl, 1
inc rsi

convert_digits:

mov bl, [rsi]

cmp bl, ' '
je store_num

cmp bl, 10
je store_num

sub bl, '0'
movzx rbx, bl

imul rax, rax, 10
add rax, rbx

inc rsi
jmp convert_digits

store_num:

cmp dl, 1
jne save_value

neg rax

save_value:

mov [rdi], rax

add rdi, 8
inc rsi

dec rcx
jnz next_num

ret


; =========================================================
; PROCEDURE: INTEGER TO STRING
; Bryce Okumara - Procedure / Functions
; =========================================================

int_to_string:

mov rsi, buffer
add rsi, 31

mov byte [rsi], 0

mov rbx, 10

convert_loop:

xor rdx, rdx
div rbx

add dl, '0'

dec rsi
mov [rsi], dl

test rax, rax
jnz convert_loop

ret
