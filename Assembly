; Rebecca Martinez
; Dot Product of Two Vectors
; U = (3,5,2)
; V = (-1,3,0)
; Result = 12

section .data
u dd 3, 5, 2
v dd -1, 3, 0

section .text
global _start

_start:

    ; Multiply first elements: 3 * -1
    mov eax, [u]
    imul eax, [v]

    ; Multiply second elements: 5 * 3
    mov ebx, [u+4]
    imul ebx, [v+4]

    ; Add to running total
    add eax, ebx

    ; Multiply third elements: 2 * 0
    mov ecx, [u+8]
    imul ecx, [v+8]

    ; Add to running total
    add eax, ecx

    ; Final result is now stored in eax
    ; eax = 12

    ; Exit program
    mov eax, 1
    int 0x80
